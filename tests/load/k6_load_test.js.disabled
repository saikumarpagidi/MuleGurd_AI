import http from 'k6/http';
import { check, sleep } from 'k6';
import { Counter } from 'k6/metrics';

export const requests = new Counter('http_reqs');

export const options = {
  stages: [
    { duration: '10s', target: 20 }, // ramp up to 20 users
    { duration: '30s', target: 100 }, // ramp up to 100 users
    { duration: '1m', target: 100 },  // stay at 100 users for 1 minute
    { duration: '20s', target: 0 },   // ramp down to 0 users
  ],
  thresholds: {
    // 50ms P95 latency SLA gate for Sprint 6
    http_req_duration: ['p(95)<50'],
    http_req_failed: ['rate<0.01'], // less than 1% errors
  },
};

export default function () {
  const url = 'http://localhost:8080/api/v1/score';
  
  const payload = JSON.stringify({
    transactionId: `txn-load-${__VU}-${__ITER}`,
    fromAccount: `acct-src-${Math.floor(Math.random() * 1000)}`,
    toAccount: `acct-dst-${Math.floor(Math.random() * 1000)}`,
    amount: Math.random() * 10000,
    timestamp: new Date().toISOString(),
    paymentFormat: 'Wire',
    currency: 'USD'
  });

  const params = {
    headers: {
      'Content-Type': 'application/json',
    },
  };

  const res = http.post(url, payload, params);
  
  check(res, {
    'status is 200': (r) => r.status === 200,
    'decision is returned': (r) => {
        try {
            return JSON.parse(r.body).decision !== undefined;
        } catch(e) {
            return false;
        }
    }
  });
  
  sleep(1);
}
