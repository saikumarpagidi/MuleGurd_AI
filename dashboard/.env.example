# MuleGuard.AI Dashboard Environment
# Copy to .env.local and adjust as needed

# ── Mock Mode ──────────────────────────────────────────────
# Set to true to use rich mock data (no backend required)
# Set to false to connect to real services
NEXT_PUBLIC_USE_MOCK_DATA=true

# ── Backend Service URLs (used when mock mode is off) ──────
AI_ENGINE_URL=http://localhost:8001
GRAPH_SERVICE_URL=http://localhost:8004
ORCHESTRATOR_URL=http://localhost:8002
EXPLAINABILITY_URL=http://localhost:8005

# ── Public API Base ────────────────────────────────────────
NEXT_PUBLIC_API_BASE=/api
