# ============================================================
# MuleGuard.AI — Environment Variable Template
#
# Usage:
#   cp .env.example .env
#
# The default values below are suitable for local development.
# Edit only if you have port conflicts on your machine.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muleguard
POSTGRES_USER=muleguard
POSTGRES_PASSWORD=muleguard_local_dev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=muleguard_neo4j

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin_local

# --- Service URLs (used by scoring-orchestrator) ---
TRANSACTION_INGEST_URL=http://localhost:8001
AI_ENGINE_URL=http://localhost:8002
GRAPH_SERVICE_URL=http://localhost:8003
FEATURE_SERVICE_URL=http://localhost:8004

# --- Risk Fusion Weights ---
# Must sum to 1.0. Adjust only with model team approval.
WEIGHT_TGN=0.50
WEIGHT_LGBM=0.30
WEIGHT_AUTOENCODER=0.15
WEIGHT_DEVICE=0.05

# --- Decision Thresholds ---
RISK_THRESHOLD_REVIEW=0.45
RISK_THRESHOLD_BLOCK=0.75
